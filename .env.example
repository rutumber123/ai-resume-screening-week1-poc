# AI Resume Screening Assistant - Environment Configuration
# Copy this file to .env and fill in values. Never commit .env.

# LLM Provider: openai | azure | mock
LLM_PROVIDER=mock

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Generation settings
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Matching weights (must sum to ~1.0)
WEIGHT_REQUIRED_SKILLS=0.40
WEIGHT_PREFERRED_SKILLS=0.15
WEIGHT_EXPERIENCE=0.20
WEIGHT_RESPONSIBILITIES=0.15
WEIGHT_EDUCATION=0.10

# Recommendation thresholds (0-100 overall match score)
THRESHOLD_SHORTLIST=75
THRESHOLD_REVIEW=50

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_RESUMES_PER_REQUEST=20
SUPPORTED_EXTENSIONS=.pdf,.docx,.txt,.md

# Application
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Week 2 evaluation
PROMPT_VERSION=v2
EVAL_CORRECTNESS_THRESHOLD=0.70
EVAL_GROUNDEDNESS_THRESHOLD=0.80
EVAL_RELEVANCE_THRESHOLD=0.70
EVAL_COMPLETENESS_THRESHOLD=0.70
EVAL_SCHEMA_THRESHOLD=1.0
EVAL_PASS_RATE_THRESHOLD=0.80
EVAL_CONSISTENCY_SCORE_TOLERANCE=5.0
EVAL_CONSISTENCY_REPEATS=3
EVAL_USE_LLM_JUDGE=false
EVAL_RESULTS_DIR=results
